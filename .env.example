APP_NAME="YineMiÇiçek"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yinemicicek.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yinemicicek
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=r2
# Livewire temp file uploadlarının nereye gideceği.
# Production'da boş bırak: default disk (r2) kullanılır, browser → R2 direkt PUT
# (R2 CORS'ta PUT izni şart: AllowedOrigins=app URL, AllowedMethods=GET/PUT/POST).
# Local dev'de "local" yap, yoksa CORS hatası alırsın.
LIVEWIRE_TMP_DISK=
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@yinemicicek.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cloudflare R2 (görsel uploadları için) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yinemicicek
R2_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://images.yinemicicek.com

VITE_APP_NAME="${APP_NAME}"
